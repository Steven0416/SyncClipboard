<Project>
  <PropertyGroup>
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0-noble</ContainerBaseImage>
    <ContainerRepository>clipbridge-relay</ContainerRepository>
    <ContainerImageTag>0.2.0-dev.1</ContainerImageTag>
    <ContainerImageFormat>Docker</ContainerImageFormat>
    <ContainerWorkingDirectory>/app</ContainerWorkingDirectory>
    <ContainerUser>root</ContainerUser>
    <ContainerAppCommandInstruction>Entrypoint</ContainerAppCommandInstruction>
    <UseAppHost>false</UseAppHost>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ContainerAppCommand Include="dotnet;SyncClipboard.Server.dll" />
    <ContainerAppCommandArgs Include="--contentRoot;/app/data" />
    <ContainerPort Include="5033" Type="tcp" />
    <ContainerLabel Include="org.opencontainers.image.source" Value="https://github.com/Steven0416/SyncClipboard" />
    <ContainerLabel Include="org.opencontainers.image.description" Value="Experimental live clipboard relay; separate test deployment" />
  </ItemGroup>
</Project>
